# Copy this file to ".env" and fill in your values.

# Which translation API to use: mymemory | libretranslate | google
TRANSLATE_PROVIDER=mymemory

PORT=3000

# --- MyMemory (default: free, no API key) ---
# Optional: add any valid email to raise the free daily limit
# (about 5,000 -> 50,000 characters/day).
MYMEMORY_EMAIL=

# --- LibreTranslate ---
# Self-host (free) or use https://libretranslate.com (needs a key)
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=

# --- Google Cloud Translation (Basic v2) ---
GOOGLE_API_KEY=
